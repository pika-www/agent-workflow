# 项目内 Ollama 0.35.0 + qwen3.5:9b 配置示例。
# 按需复制到 openwiki-data/.env；不要覆盖已有配置或提交真实 API 密钥。
# 2026-10-02：模型已安装，真实工具往返、示例学习更新与只读问答已验证。
# Wiki 内容经过人工核对校正；未配置自动监听或定时学习。
# 先运行 启动OpenWiki.command；入口不下载模型、不自动学习。
OPENWIKI_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11436/v1
# ollama 是本地接口要求的非秘密占位值。
OPENAI_COMPATIBLE_API_KEY=ollama
OPENWIKI_MODEL_ID=qwen3.5:9b

# 使用 Chat Completions 兼容接口及默认非流式路径。
OPENWIKI_OPENAI_COMPATIBLE_USE_RESPONSES_API=false
OPENWIKI_OPENAI_COMPATIBLE_STREAMING=false
OPENWIKI_OPENAI_COMPATIBLE_STREAM_MESSAGES=false

# Ollama 0.35 兼容接口使用 reasoning_effort=none 关闭 thinking。
# 本次模型已完成实际工具调用往返验证；其他服务需重新核实，不能直接套用。
OPENWIKI_OPENAI_COMPATIBLE_REASONING_EFFORT_SUPPORTED=true
OPENWIKI_REASONING_EFFORT=none

# 仅限制单次输出，不限制整个学习任务；先用一份短资料验证。
OPENWIKI_MAX_OUTPUT_TOKENS=4096

# 服务启动器另行设置：OLLAMA_CONTEXT_LENGTH=32768（32K）、
# OLLAMA_NUM_PARALLEL=1、OLLAMA_NO_CLOUD=1。
# 这些是 Ollama 服务环境参数，不由 OpenWiki 的 .env 配置上下文。
# 模型保存在项目内 openwiki-runtime/models/；本配置不用默认 11434 端口。
